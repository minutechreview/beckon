# Copy to /opt/beckon/shared/.env (chmod 600) on the VM. Never commit it. Values below are placeholders.
# POSTGRES_PASSWORD (the owner: migrations, backups) goes into a URL: use `openssl rand -hex 32`. It only takes effect
# when the volume is first created.
BECKON_HOST=app.example.com
POSTGRES_PASSWORD=change-me-long-random
# The app's own database role (beckon_app: rows only, not the owner). deploy.sh generates it (hex) if it is missing.
# APP_DB_PASSWORD=

AUTH_SECRET=                 # openssl rand -base64 32
EMAIL_FROM="Beckon <login@example.com>"
# Replies to sign-in emails; default support@ the EMAIL_FROM domain (it must receive mail)
# EMAIL_REPLY_TO=support@example.com
# Magic-link email: set SMTP_URL (any SMTP provider; percent-encode the username and password) or, instead,
# RESEND_API_KEY. SMTP_URL wins if both are set. smtps://...:465 is TLS from the start; smtp://...:587 requires STARTTLS.
# Hetzner blocks outbound port 465 on new accounts, so on Hetzner use smtp://...:587.
SMTP_URL=
RESEND_API_KEY=

# Web Push. Generate once and never rotate casually: new keys orphan every existing push subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Stripe (leave out until billing is live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Optional GitHub sign-in
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Self-hosting (docs/self-hosting.md). Leave all of these out on the hosted service.
# Every account gets every feature. The server refuses to start with this and any STRIPE_* key set.
# BECKON_PLAN_LIMITS=off
# Who may create an account (comma-separated). Unset: anyone. Existing accounts always keep working.
# BECKON_ALLOWED_EMAILS=you@example.com
# BECKON_ALLOWED_EMAIL_DOMAINS=example.com
# Who runs this server, for /terms and /privacy (contact addresses once #27 lands). The pages say they are drafts
# until the first three are set.
# BECKON_OPERATOR="Example Ltd"
# BECKON_LEGAL_COUNTRY="England and Wales"
# BECKON_SUPPORT_EMAIL=support@example.com
# BECKON_PRIVACY_EMAIL=          # default: BECKON_SUPPORT_EMAIL
# BECKON_SECURITY_EMAIL=         # default: BECKON_SUPPORT_EMAIL
# BECKON_LEGAL_EFFECTIVE=        # the policies' effective date, YYYY-MM-DD

# Offsite backups (optional): an rclone remote name, e.g. r2:beckon-backups. Needs BACKUP_AGE_RECIPIENT (an age
# public key; keep the private key off the server): nothing is copied offsite unencrypted.
BACKUP_RCLONE_REMOTE=
BACKUP_AGE_RECIPIENT=
# Dead man's switch for the nightly backup, e.g. a healthchecks.io ping URL (optional)
BACKUP_PING_URL=
# Disk, memory and container check every 5 minutes (hostcheck.sh): a heartbeat URL, pinged only when all is well (optional)
HOSTCHECK_PING_URL=
