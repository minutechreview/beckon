# Copy to web/.env.local. Defaults below match docker-compose.yml.
DATABASE_URL=postgres://beckon:beckon@localhost:5432/beckon

# Dev only. The server refuses to start if this is set with NODE_ENV=production.
BECKON_DEV_LOGIN=1       # adds a "Dev sign-in" form (no email, no OAuth); used by e2e tests

# Auth.js. A dev default is used outside production; set a real one in production.
# AUTH_SECRET=
# GitHub OAuth (optional; the button only appears when both are set).
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# Production magic links: set SMTP_URL (any SMTP provider, e.g. Amazon SES) or RESEND_API_KEY. SMTP_URL wins if both
# are set. Percent-encode the username and password. smtps:// is TLS from the start (port 465); smtp:// requires
# STARTTLS (port 587).
# SMTP_URL=smtps://USER:PASSWORD@email-smtp.eu-west-1.amazonaws.com:465
# RESEND_API_KEY=
# EMAIL_FROM=Beckon <login@beckoncli.com>

# Web Push (M4). Generate a key pair once with `npm run vapid`, and keep the private key secret.
# Without these the server still evaluates notification rules but cannot send pushes.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Dev only: lets pushes go to a mock endpoint on 127.0.0.1. The server refuses to start in production with this set.
# BECKON_PUSH_ALLOW_LOCAL_ENDPOINTS=1
# Dev only: extra hostnames allowed to load the dev server (an HTTPS tunnel for phone testing).
# BECKON_DEV_ORIGINS=my-tunnel.example.com

# ---- Production (Fly secrets; see docs/deploy.md) ----
# AUTH_URL=https://beckoncli.com            # https origin; required in production (also in fly.*.toml)
# BECKON_PUBLIC_URL=https://beckoncli.com   # links Stripe and email send people back to (defaults to AUTH_URL)
# STRIPE_SECRET_KEY=rk_test_...             # restricted key; test on staging, live on production
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# BECKON_RELEASE_REPO=jaystewartuk/beckon   # where install.sh downloads the helper from

# ---- Self-hosting (docs/self-hosting.md) ----
# BECKON_PLAN_LIMITS=off                    # every account gets every feature; refused with any STRIPE_* key set
# BECKON_ALLOWED_EMAILS=you@example.com     # comma-separated; new accounts only, existing ones always work
# BECKON_ALLOWED_EMAIL_DOMAINS=example.com  # comma-separated; exact domains, no subdomains
# For /terms and /privacy (operator, country, date now; contact addresses once #27 lands). Default to the hosted
# service's on beckoncli.com (or with no AUTH_URL), else blank.
# BECKON_OPERATOR="Example Ltd"
# BECKON_LEGAL_COUNTRY="England and Wales"
# BECKON_LEGAL_EFFECTIVE=2026-10-10
# BECKON_SUPPORT_EMAIL=support@example.com
# BECKON_PRIVACY_EMAIL=privacy@example.com  # default: BECKON_SUPPORT_EMAIL
# BECKON_SECURITY_EMAIL=security@example.com  # default: BECKON_SUPPORT_EMAIL
# Test-only; the server refuses to start in production with any of these set:
# BECKON_RATE_LIMIT_OFF=1
